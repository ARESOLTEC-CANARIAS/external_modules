<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Order Form View - Add markup next to margin in totals -->
    <record model="ir.ui.view" id="sale_margin_compute_custom_form">
        <field name="name">sale.order.margin.markup.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order"/>
        <field name="arch" type="xml">
            <!-- Add Markup % after the margin percent span -->
            <xpath expr="//field[@name='margin_percent']/.." position="after">
                <span class="oe_inline" invisible="amount_untaxed == 0">
                    / <field name="margin_markup_percent" nolabel="1" class="oe_inline" widget="percentage"/> Markup
                </span>
            </xpath>
        </field>
    </record>

    <!-- Inherit Order Line List View - Add markup column -->
    <record model="ir.ui.view" id="sale_margin_compute_custom_line_list">
        <field name="name">sale.order.line.list.markup.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='margin_percent']" position="after">
                <field name="margin_markup_percent" optional="hide" widget="percentage"
                    invisible="price_subtotal == 0"/>
            </xpath>
        </field>
    </record>

    <!-- Add margin and markup to Quotation Tree View -->
    <record model="ir.ui.view" id="sale_margin_compute_custom_quotation_tree">
        <field name="name">sale.quotation.tree.margin.markup</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="amount_untaxed" position="before">
                <field name="margin" optional="show" groups="base.group_user"/>
                <field name="margin_percent" optional="show" widget="percentage" groups="base.group_user"/>
                <field name="margin_markup_percent" optional="show" widget="percentage" groups="base.group_user"/>
            </field>
        </field>
    </record>

    <!-- Add margin and markup to Sales Order Tree View -->
    <record model="ir.ui.view" id="sale_margin_compute_custom_order_tree">
        <field name="name">sale.order.tree.margin.markup</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="amount_untaxed" position="before">
                <field name="margin" optional="show" groups="base.group_user"/>
                <field name="margin_percent" optional="show" widget="percentage" groups="base.group_user"/>
                <field name="margin_markup_percent" optional="show" widget="percentage" groups="base.group_user"/>
            </field>
        </field>
    </record>

</odoo>
