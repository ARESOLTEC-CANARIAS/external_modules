<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

  <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
    <xpath expr="//ProductCard" position="attributes">
      <attribute name="class">this.getClass(product)</attribute>
      <attribute name="wise_quantites">this.state.wiseQuantitesByProductTmpId[product.raw.product_tmpl_id]</attribute>
      <attribute name="is_display_stock">this.pos.config.is_display_stock</attribute>
      <attribute name="display_total_variant_stock">
        this.pos.config.display_total_variant_stock
      </attribute>
    </xpath>

    <xpath expr="//ActionpadWidget" position="attributes">
      <attribute name="actionToTrigger">wise_pay</attribute>
    </xpath>

    <xpath expr="//button[@t-if='!pos.scanning']" position="attributes">
      <attribute name="t-on-click">wise_pay</attribute>
    </xpath>
  </t>

</templates>
