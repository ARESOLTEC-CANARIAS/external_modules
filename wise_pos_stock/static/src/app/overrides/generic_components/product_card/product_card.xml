<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
  <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('product-information-tag')]" position="after">
      <div class="position-absolute d-flex gap-1">
        <t t-if="props.is_display_stock and props.product.is_storable">
          <t t-if="props.display_total_variant_stock">
            <span class="btn btn-sm" t-attf-class="{{ props.product.total_variant_stock.class }}" t-out="props.product.total_variant_stock.qty"/>
          </t>
          <t t-else="">
            <t t-foreach="props.product.wise_quantites.slice(0, 3)" t-as="wise_quantity" t-key="wise_quantity.id">
              <span class="btn btn-sm" t-attf-class="{{wise_quantity.class}}" t-out="wise_quantity.qty"/>
            </t>
            <t t-if="props.product.wise_quantites.length &gt; 3">
              <span class="">...</span>
            </t>
          </t>
        </t>
      </div>
    </xpath>
  </t>
</templates>
