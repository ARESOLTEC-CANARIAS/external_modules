<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
  <t t-inherit="point_of_sale.ProductConfiguratorPopup" t-inherit-mode="extension">
    <xpath expr="//div[@t-if='isArchivedCombination()']" position="after">
      <div t-if="isProductOutOfStock()" class="alert alert-warning mt-3">
        <span >Not enough stock to fulfill the request.</span>
      </div>
    </xpath>
    <xpath expr="//button[@t-on-click='confirm']" position="attributes">
      <attribute name="t-att-class">{'disabled': isArchivedCombination(),'disabled': isProductOutOfStock()}</attribute>
    </xpath>
  </t>
</templates>
