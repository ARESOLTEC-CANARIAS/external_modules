<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asterisk Security Groups -->
    <record id="group_asterisk_user" model="res.groups">
        <field name="name">Asterisk User</field>
        <field name="category_id" ref="base.module_category_phone"/>
        <field name="comment">Basic Asterisk user with call access</field>
    </record>

    <record id="group_asterisk_manager" model="res.groups">
        <field name="name">Asterisk Manager</field>
        <field name="category_id" ref="base.module_category_phone"/>
        <field name="implied_ids" eval="[(4, ref('group_asterisk_user'))]"/>
        <field name="comment">Asterisk manager with configuration access</field>
    </record>

    <record id="group_asterisk_admin" model="res.groups">
        <field name="name">Asterisk Administrator</field>
        <field name="category_id" ref="base.module_category_phone"/>
        <field name="implied_ids" eval="[(4, ref('group_asterisk_manager'))]"/>
        <field name="comment">Full Asterisk administration access</field>
    </record>

    <!-- Record Rules -->
    
    <!-- Asterisk Server Rules -->
    <record id="asterisk_server_user_rule" model="ir.rule">
        <field name="name">Asterisk Server: User Access</field>
        <field name="model_id" ref="model_asterisk_server"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_asterisk_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="asterisk_server_manager_rule" model="ir.rule">
        <field name="name">Asterisk Server: Manager Access</field>
        <field name="model_id" ref="model_asterisk_server"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_asterisk_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Asterisk Call Rules -->
    <record id="asterisk_call_user_rule" model="ir.rule">
        <field name="name">Asterisk Call: User Access</field>
        <field name="model_id" ref="model_asterisk_call"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_asterisk_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="asterisk_call_manager_rule" model="ir.rule">
        <field name="name">Asterisk Call: Manager Access</field>
        <field name="model_id" ref="model_asterisk_call"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_asterisk_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Asterisk User Rules -->
    <record id="asterisk_user_own_rule" model="ir.rule">
        <field name="name">Asterisk User: Own Configuration</field>
        <field name="model_id" ref="model_asterisk_user"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_asterisk_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="asterisk_user_manager_rule" model="ir.rule">
        <field name="name">Asterisk User: Manager Access</field>
        <field name="model_id" ref="model_asterisk_user"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_asterisk_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Asterisk Recording Rules -->
    <record id="asterisk_recording_user_rule" model="ir.rule">
        <field name="name">Asterisk Recording: User Access</field>
        <field name="model_id" ref="model_asterisk_recording"/>
        <field name="domain_force">['|', ('call_id.user_id', '=', user.id), ('call_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_asterisk_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="asterisk_recording_manager_rule" model="ir.rule">
        <field name="name">Asterisk Recording: Manager Access</field>
        <field name="model_id" ref="model_asterisk_recording"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_asterisk_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>

