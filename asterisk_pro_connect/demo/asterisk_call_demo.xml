<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo Calls -->
    <record id="demo_call_1" model="asterisk.call">
        <field name="unique_id">demo_call_001</field>
        <field name="server_id" ref="demo_asterisk_server"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="direction">inbound</field>
        <field name="caller_number">+1234567890</field>
        <field name="called_number">1001</field>
        <field name="status">answered</field>
        <field name="start_time" eval="(DateTime.now() - timedelta(hours=2))"/>
        <field name="answer_time" eval="(DateTime.now() - timedelta(hours=2, minutes=-1))"/>
        <field name="end_time" eval="(DateTime.now() - timedelta(hours=2, minutes=-5))"/>
    </record>

    <record id="demo_call_2" model="asterisk.call">
        <field name="unique_id">demo_call_002</field>
        <field name="server_id" ref="demo_asterisk_server"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="direction">outbound</field>
        <field name="caller_number">1001</field>
        <field name="called_number">+0987654321</field>
        <field name="status">ended</field>
        <field name="start_time" eval="(DateTime.now() - timedelta(hours=1))"/>
        <field name="answer_time" eval="(DateTime.now() - timedelta(hours=1, minutes=-2))"/>
        <field name="end_time" eval="(DateTime.now() - timedelta(hours=1, minutes=-8))"/>
    </record>

    <record id="demo_call_3" model="asterisk.call">
        <field name="unique_id">demo_call_003</field>
        <field name="server_id" ref="demo_asterisk_server"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="direction">inbound</field>
        <field name="caller_number">+1122334455</field>
        <field name="called_number">1001</field>
        <field name="status">no_answer</field>
        <field name="start_time" eval="(DateTime.now() - timedelta(minutes=30))"/>
    </record>

</odoo>

