<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron Job for Event Processing -->
    <record id="ir_cron_process_asterisk_events" model="ir.cron">
        <field name="name">Process Asterisk Events</field>
        <field name="model_id" ref="model_asterisk_event"/>
        <field name="state">code</field>
        <field name="code">
            # Process unprocessed events
            events = model.search([('processed', '=', False)], limit=100)
            for event in events:
                event.process_event()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <!-- Cron Job for Cleanup -->
    <record id="ir_cron_cleanup_old_events" model="ir.cron">
        <field name="name">Cleanup Old Asterisk Events</field>
        <field name="model_id" ref="model_asterisk_event"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_old_events(days=30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>

