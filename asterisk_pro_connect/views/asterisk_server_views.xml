<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asterisk Server Views -->
    
    <!-- Tree View -->
    <record id="view_asterisk_server_tree" model="ir.ui.view">
        <field name="name">asterisk.server.tree</field>
        <field name="model">asterisk.server</field>
        <field name="arch" type="xml">
            <tree string="Asterisk Servers">
                <field name="name"/>
                <field name="host"/>
                <field name="port"/>
                <field name="connection_status"/>
                <field name="version"/>
                <field name="active"/>
                <field name="total_calls"/>
                <field name="calls_today"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_asterisk_server_form" model="ir.ui.view">
        <field name="name">asterisk.server.form</field>
        <field name="model">asterisk.server</field>
        <field name="arch" type="xml">
            <form string="Asterisk Server">
                <header>
                    <button name="test_connection" type="object" string="Test Connection" 
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_calls" type="object" 
                                class="oe_stat_button" icon="fa-phone">
                            <field name="total_calls" widget="statinfo" string="Total Calls"/>
                        </button>
                        <button name="action_view_users" type="object" 
                                class="oe_stat_button" icon="fa-users">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="user_ids" widget="integer"/>
                                </span>
                                <span class="o_stat_text">Users</span>
                            </div>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Inactive" bg_color="bg-danger" 
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Server Name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="connection">
                            <field name="host"/>
                            <field name="port"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="active"/>
                        </group>
                        <group name="status">
                            <field name="connection_status"/>
                            <field name="version"/>
                            <field name="last_connection_test"/>
                            <field name="connection_error" attrs="{'invisible': [('connection_error', '=', False)]}"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Configuration" name="config">
                            <group>
                                <group name="options">
                                    <field name="auto_create_partners"/>
                                    <field name="call_popup_enabled"/>
                                    <field name="recording_enabled"/>
                                    <field name="recording_path" attrs="{'invisible': [('recording_enabled', '=', False)]}"/>
                                </group>
                                <group name="statistics">
                                    <field name="calls_today"/>
                                    <field name="active_calls"/>
                                </group>
                            </group>
                        </page>
                        <page string="Users" name="users">
                            <field name="user_ids">
                                <tree>
                                    <field name="user_id"/>
                                    <field name="extension"/>
                                    <field name="online_status"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_asterisk_server" model="ir.actions.act_window">
        <field name="name">Asterisk Servers</field>
        <field name="res_model">asterisk.server</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Asterisk server configuration
            </p>
            <p>
                Configure your Asterisk servers to enable click-to-call functionality
                and call logging in Odoo.
            </p>
        </field>
    </record>

</odoo>

